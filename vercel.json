{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "x-markdown-tokens": "1046",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/$",
      "headers": {
        "Link": "</.well-known/api-catalog>; rel=\"api-catalog\", </llms.txt>; rel=\"service-doc\"; type=\"text/markdown\", </index.md>; rel=\"alternate\"; type=\"text/markdown\"",
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/index\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "x-markdown-tokens": "1046"
      },
      "continue": true
    },
    {
      "src": "^/llms\\.txt$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/auth\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/api-catalog$",
      "headers": {
        "Content-Type": "application/linkset+json"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/oauth-protected-resource$",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/(agent-card\\.json|mcp/server-card\\.json)$",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/agent-skills/index\\.json$",
      "headers": {
        "Content-Type": "application/json; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/agent-skills/(.*)/SKILL\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      },
      "continue": true
    }
  ]
}
